# Copy to .env and fill in. Never commit .env.

# --- Model (swap provider without code changes) ---
MODEL_PROVIDER=gemini            # gemini | openai_compat
MODEL_NAME=gemini-3.5-flash
GEMINI_API_KEY=                  # free key: https://aistudio.google.com -> Get API key
MODEL_RPM=5                      # client-side pacing; Gemini free tier: 5/min and 20/day (0 = off)
# openai_compat (GitHub Models, Groq, OpenRouter, Ollama):
#   GitHub Models: MODEL_BASE_URL=https://models.github.ai/inference  MODEL_NAME=openai/gpt-4o-mini
#                  MODEL_API_KEY = a GitHub token with the "Models: read" permission
#   Ollama:        MODEL_BASE_URL=http://localhost:11434/v1  MODEL_API_KEY= (empty)
MODEL_BASE_URL=
MODEL_API_KEY=

# --- GitHub sandbox (private repo you own) ---
# Fine-grained token, "Only select repositories" -> the sandbox repo.
# Agent needs: Issues read/write, Pull requests read, Contents read, Metadata read.
# Seed script additionally needs: Pull requests write, Contents write.
GITHUB_TOKEN=
GITHUB_REPO=owner/ledgerly-api
WRITE_REPO_ALLOWLIST=owner/ledgerly-api   # comma-separated; writes anywhere else are refused
GITHUB_SEED_TOKEN=               # optional: broader token used only by scripts/seed_sandbox.py

# --- Limits ---
MAX_COST_USD=5
MAX_STEPS=10
STEP_TIMEOUT_S=90               # per model call (includes 429 backoff) and per tool call

# --- Retrieval ---
RETRIEVAL_MODE=hybrid            # bm25 | vector | hybrid
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Reproducibility ---
SEED=42
